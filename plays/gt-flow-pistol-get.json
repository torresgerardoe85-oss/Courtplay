  "source": {
    "type": "source-informed adaptation",
    "philosophy": [
      "Early offense enters a common reaction system instead of stopping for set-play calls.",
      "First read is early advantage; if neutral, flow immediately to the next trigger.",
      "Adapted for two non-shooting bigs: 4/5 screen, roll, seal, handoff and occupy dunker; no required pick-and-pop."
    ],
    "sources": [
      "VIRTUS OFFENSE — Transition: Early Drag, Early DHO #4",
