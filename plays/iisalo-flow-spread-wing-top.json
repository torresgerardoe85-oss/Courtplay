{
  "version": 2,
  "name": "IISALO FLOW — Spread → Wing → Top",
  "description": "Core de tres lados: first-side Spread/Angle P&R → reverse → second-side throw-and-chase Wing/Empty P&R → reverse → third-side Top P&R.",
  "status": "Source-based reconstruction — 4/1 roster adaptation",
  "system": "Tuomas Iisalo Flow",
  "categories": [
    "transition",
    "flow",
    "pnr"
  ],
  "source": {
    "primary": [
      "Adam Pike — Tuomas Iisalo System / Flow: first side 1–5 P&R with corners filled and 4 at slot; second side 2–4 Empty P&R; third side returns to 1–5 Top P&R.",
      "FIBA Basketball — Bonn: rapid side-to-side decisions and 'third side' action; entries feed the same reaction system."
    ],
    "adaptation": "4 y 5 son screen/roll players. No pop obligatorio. La base animada es una sola posesión neutral: cada reverse ocurre solo si la acción anterior no creó ventaja."
  },
  "animationStandard": {
    "name": "COURTPLAY_ANIMATION_TIMING_STANDARD",
    "screenSequence": "APPROACH → SET → USE → RELEASE",
    "rules": [
      "Simultaneous only when actions share the same basketball trigger",
      "Pass is completed before dependent next action",
      "No screen-and-roll at the same instant",
      "Phase end becomes the exact next phase start",
      "Review at 1x, 0.75x and 0.5x before approval"
    ]
  },
  "teachingReads": [
    "FIRST SIDE: atacar si Spread/Angle crea ventaja.",
    "SECOND SIDE: throw-and-chase 4→2 into Empty/Wing P&R.",
    "THIRD SIDE: 1–5 Top P&R desde un ángulo diferente.",
    "Las tres sides no son llamadas separadas; son continuidad."
  ],
