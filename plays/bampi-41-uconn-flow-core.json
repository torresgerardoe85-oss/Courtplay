  "source": {
    "primary": "UCONN Huskies Playbook Volume 2 — p.89 · High Hit: Gut Zoom: Swing: Zoom: Zoom",
    "supporting": [
      "p.83 · High Hit: Gut Zoom: Over: Seal",
      "p.84/87 · High Hit: Gut Zoom: Swing: Zoom / Wide"
    ],
    "adaptation": "BAMPI 4-Out 1-In: 4 connector; 5 rim big/screener/roller; continuation is read-based rather than a mandatory memorized finish."
  },
  "teachingGoal": "ARRIVAL → HIGH HIT → GUT ZOOM → SECOND ZOOM → DHO → PnR, atacando cualquier ventaja antes de continuar.",
  "teachingRules": [
    "VENTAJA > PATRÓN: aro, seal, backdoor, curl o closeout terminan la secuencia y se atacan.",
    "Gut: 5 se planta antes de que 2 use la cortina; 2 pasa hombro con cadera y no atraviesa el bloqueador.",
    "DHO: APPROACH → CONTACT/TRANSFER → receptor POR ENCIMA → pasador POR DEBAJO y separación inmediata.",
    "El balón cambia de lado antes de activar el segundo Zoom.",
    "4 es connector: screen, DHO, clear; no necesita crear con drible.",
    "5 hace acciones simples: screen, pop corto para conectar, DHO, ball screen y roll.",
    "PnR final: SET → USE OVER → CLEAR SCREEN → TURN CORNER + ROLL por carriles separados.",
    "2/3/4 mantienen spacing; nadie invade la pintura mientras 5 rola."
  ],
  "animationStandard": {
    "screenSequence": "SET → USE OVER → CLEAR SCREEN → TURN CORNER + ROLL",
    "handoffSequence": "APPROACH → PRESENT/CONTACT → ONE TRANSFER → RECEIVER OVER → GIVER UNDER + SEPARATE",
    "screenUseClearance": 58,
    "principle": "CREAR VENTAJA → LEER → DECIDIR → EJECUTAR"
  },
