{
  "version": 2,
  "name": "IISALO ENTRY — Iverson Follow Empty",
  "description": "Entrada moderna: baseline clear + Iverson cut → catch on empty side → screener follows into Empty P&R. Flex queda como wrinkle aparte, no como base.",
  "status": "Source-based reconstruction",
  "system": "Tuomas Iisalo Iverson Series",
  "categories": [
    "flow",
    "pnr",
    "iverson",
    "quick"
  ],
  "source": {
    "primary": [
      "FIBA Basketball — Bonn frequently used Iverson/staggered entries; baseline clear empties the receiving side and the space can flow directly into P&R.",
      "Adam Pike — Iverson Follow Empty is a recurring Iisalo action carried from Paris into Memphis."
    ],
    "adaptation": "Con 4/5 no tiradores, 4 ayuda a la entrada y luego limpia; 5 es el follower/screener y roller."
  },
  "animationStandard": {
    "name": "COURTPLAY_ANIMATION_TIMING_STANDARD",
    "screenSequence": "APPROACH → SET → USE → RELEASE",
    "rules": [
      "Simultaneous only when actions share the same basketball trigger",
      "Pass is completed before dependent next action",
      "No screen-and-roll at the same instant",
      "Phase end becomes the exact next phase start",
      "Review at 1x, 0.75x and 0.5x before approval"
    ]
  },
  "teachingReads": [
    "Baseline clear and Iverson movement are coordinated, but the two screening contacts occur in sequence.",
    "Catch on an empty side.",
    "5 follows the cutter into Empty P&R.",
    "Score the first advantage; do not force continuation."
  ],
