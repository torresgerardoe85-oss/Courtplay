{
  "version": 3,
  "name": "MODERN FLOW — Early Wide Drag",
  "description": "Llegada moderna separada por triggers reales: transición en cinco lanes → 5 planta Drag → 1 usa → 5 roll + weak lift → reverse si queda neutral. Diseñado para que CourtPlay no anime screen/use/roll a la vez.",
  "status": "Research / Testing — source-based reconstruction",
  "system": "41 Modern Flow / Tuomas Iisalo principles",
  "categories": [
    "transition",
    "flow",
    "pnr"
  ],
  "source": {
    "basis": [
      "FIBA — Bonn: early offense y Drag/third-side reactions.",
      "FIBA terminology: Drag es ball screen en transición."
    ],
    "adaptation": "4-Out 1-In; 5 rim runner/screener. 4 llega como trail/second-side connector."
  },
  "animationStandard": {
    "screenSequence": "APPROACH → SET → USE → RELEASE",
    "simultaneousRule": "Solo transición y reacciones nacidas del mismo trigger pueden ir simultáneas.",
    "screenUserRule": "El usuario de toda cortina pasa OVER/basket-side, hombro con cadera; nunca por debajo."
  },
  "teachingReads": [
    "Rim run primero.",
    "Si no hay ventaja: Drag.",
    "Si Drag queda neutral: reverse inmediato al second side."
  ],
