{
  "version": 2,
  "name": "GT FLOW — Early Drag",
  "description": "Llegar jugando: advance + wide lanes + 5 Drag cuando no existe ventaja de rim run. 5 se establece, 1 usa hombro con cadera, 5 rola después del uso y 2 levanta como reacción. 4 trail y 3 deep corner mantienen spacing.",
  "status": "Official team pattern — source-informed adaptation",
  "system": "GT FLOW",
  "categories": [
    "transition",
    "flow",
    "pnr"
  ],
  "source": {
    "primary": [
      "FIBA Basketball — Mountaintop: A closer look at Telekom Baskets Bonn (Tuomas Iisalo: early offense generally starts with a 1–5 drag; the ball may be advanced by anyone).",
      "FIBA Basketball — Red Hot: a closer look at BAXI Manresa (Drag as transition/early-offense entry that flows into further actions when no advantage is created)."
    ],
    "adaptation": "Versión para nuestro equipo: 5 roll como continuación principal; 4 trail/second-side, sin pop obligatorio; 2/3 corren ancho para abrir la pintura."
  },
  "animationStandard": {
    "name": "COURTPLAY_ANIMATION_TIMING_STANDARD",
    "screenSequence": "APPROACH → SET → USE → RELEASE",
    "rules": [
      "Transition movements are simultaneous only because they share the same arrival trigger",
      "5 must be established before 1 turns the corner",
      "1 passes shoulder-to-hip without crossing the screener",
      "5 rolls only after 1 has cleared the screen",
      "2 lifts only after the PnR has forced help/created the passing window",
      "Ball ownership remains with 1 throughout this base branch",
      "Phase end equals next phase start"
    ]
  },
  "basketballLogic": {
    "purpose": "Crear ventaja antes de que la defensa quede organizada, con la pintura abierta y una lectura simple de dos jugadores.",
    "initialRules": [
      "1 advances in a guard lane with the ball",
      "2 and 3 sprint to deep wide lanes/corners",
      "4 trails opposite the ball as second-side outlet",
      "5 rim-runs if he has an immediate race advantage; otherwise he becomes the Drag screener"
    ],
    "baseReads": [
      "1: turn corner and score first",
      "5: hard roll after the ball handler clears the screen",
      "2: weak-side lift on the roll/help trigger",
      "3: hold deep corner",
      "4: hold trail/second-side spacing"
    ],
    "nextIfNeutral": "Reverse/flow to second side. That continuation is taught as the separate Drag → Second Side pattern."
  },
  "teachingReads": [
    "Si 5 gana la carrera antes de la pantalla: rim run y sello temprano.",
    "Si no gana la carrera: Drag inmediato.",
    "El screener no rola antes de que 1 realmente use la pantalla.",
    "1 debe rozar hombro con cadera; no abrirse demasiado.",
    "Si no se crea ventaja, no parar la ofensiva: entrar a Second Side."
  ],
