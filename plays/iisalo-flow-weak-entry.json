  "source": {
    "primary": [
      "Adam Pike — 2025–26 Iisalo offence: if the team is not set in five-lane spacing, it can 'Weak' the floor; the cutter goes through to the opposite corner and the group transitions directly into Flow (Spread + Wing P&R).",
      "FIBA Basketball — Iisalo uses different entries to enter the same reaction system rather than relying on rigid set calls."
    ],
    "adaptation": "4/5 remain non-shooting roles: 5 first-side screener/roller; 4 becomes second-side screener rather than a stationary stretch forward."
  },
  "animationStandard": {
    "name": "COURTPLAY_ANIMATION_TIMING_STANDARD",
